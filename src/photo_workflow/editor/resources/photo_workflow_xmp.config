# ExifTool config defining the photo-workflow XMP namespace (pwf).
# pwf:CropSource records who produced the crs: crop in a sidecar: "manual" or "auto".
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        pwf => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::pwf' },
        },
    },
);

%Image::ExifTool::UserDefined::pwf = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-pwf', 2 => 'Image' },
    NAMESPACE => { 'pwf' => 'https://github.com/storercd/photo-workflow/ns/1.0/' },
    CropSource => { Writable => 'string' },
);

1;
